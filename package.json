{
  "name": "carbon-forest-platform",
  "version": "1.0.0",
  "private": true,
  "description": "人工林碳增汇核算与守绿代际台账平台 - 全栈项目",
  "scripts": {
    "setup": "npm install && npm run install:backend && npm run install:frontend && npm run seed:backend && echo '\\n🎉 碳汇平台环境配置完成！运行 npm run dev 一键启动前后端\\n'",
    "install:all": "npm install && npm run install:backend && npm run install:frontend",
    "install:backend": "cd backend && (test -d venv || python3 -m venv venv) && . venv/bin/activate && pip install -r requirements.txt",
    "install:frontend": "cd frontend && npm install",
    "seed:backend": "cd backend && . venv/bin/activate && python -m app.seed",
    "dev": "concurrently -n BACKEND,FRONTEND -c green,blue \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && . venv/bin/activate && uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "dev:frontend": "cd frontend && npm run dev",
    "start": "npm run dev",
    "build": "npm run build:frontend",
    "build:frontend": "cd frontend && npm run build",
    "lint": "npm run lint:frontend && npm run lint:backend",
    "lint:frontend": "cd frontend && npm run lint",
    "lint:backend": "cd backend && . venv/bin/activate && flake8 app/ --max-line-length=100 --extend-ignore=E203,W503",
    "format": "npm run format:frontend && npm run format:backend",
    "format:frontend": "cd frontend && npm run format",
    "format:backend": "cd backend && . venv/bin/activate && black app/ && isort app/",
    "prepare": "husky",
    "docker:up": "docker-compose up -d --build",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "commitlint": "commitlint --edit"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "concurrently": "^8.2.2",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10"
  },
  "lint-staged": {
    "frontend/src/**/*.{js,jsx,ts,tsx,json,css,md}": [
      "./frontend/node_modules/.bin/prettier --write"
    ],
    "frontend/src/**/*.{js,jsx,ts,tsx}": [
      "./frontend/node_modules/.bin/eslint --fix --max-warnings=0"
    ],
    "backend/app/**/*.py": [
      "./backend/venv/bin/black",
      "./backend/venv/bin/isort",
      "./backend/venv/bin/flake8 --max-line-length=100 --extend-ignore=E203,W503"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "type-enum": [
        2,
        "always",
        [
          "feat",
          "fix",
          "docs",
          "style",
          "refactor",
          "perf",
          "test",
          "build",
          "ci",
          "chore",
          "revert",
          "carbon"
        ]
      ],
      "subject-case": [
        0
      ]
    }
  }
}
